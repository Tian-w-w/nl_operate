# Local synthetic demo only. Never expose demo auth to the internet.
DATABASE_URL=sqlite:///./runtime/llm4web_demo.db
AUTH_MODE=demo
REFERENCE_TIME=2026-10-26T12:00:00+08:00
RESULT_TTL_SECONDS=1800
CONFIRM_TTL_SECONDS=300
# Offline by default. OpenAI calls require explicit key/rates/budgets;
# local deployments use the empty LOCAL_MODEL_* fields instead.
MODEL_ADAPTER=rules
MODEL_CALLS_ENABLED=false
MODEL_NAME=
# Local deployment: set MODEL_ADAPTER=local, fill the base URL (including /v1
# when required by your server), model name, then enable calls. Leave blank now.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_PROTOCOL=chat_completions
OPENAI_API_KEY=
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_OUTPUT_TOKENS=1024
MODEL_MAX_CALLS_PER_SESSION=20
MODEL_BUDGET_USD_PER_SESSION=0
# Shared across all sessions in this database; changing demo identity cannot reset it.
MODEL_PROJECT_BUDGET_USD=0
# Supply the chosen model's current rates; never assume a default price.
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Durable read-only Agent limits. No hard-coded business branching threshold.
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_SECONDS=90
AGENT_REPEAT_LIMIT=1
